{
  "id": "tomrade/xai",
  "version": "0.1.0",
  "title": "xAI Grok",
  "description": "Grok models from xAI: paste an xAI API key in Settings → Assistant and the assistant runs on Grok, searching the web with xAI's own search.",
  "license": "Apache-2.0",
  "author": {
    "name": "Tomrade"
  },
  "repository": "https://github.com/haoyuant/tomrade-plugins",
  "engines": {
    "sdk": "^0.2.16"
  },
  "main": "dist/index.js",
  "icon": "icon.svg",
  "permissions": {
    "network": [
      "x.ai"
    ],
    "fs": "none",
    "exec": false
  },
  "inject": [
    "models"
  ],
  "optional": [],
  "contributes": {
    "modelProviders": [
      "xai"
    ]
  }
}
