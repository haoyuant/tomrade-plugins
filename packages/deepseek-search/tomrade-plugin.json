{
  "id": "tomrade/deepseek-search",
  "version": "0.1.0",
  "title": "DeepSeek Search",
  "description": "Lets the assistant search the web and read pages through DeepSeek's search API. Nothing to set up: it uses the API key of your DeepSeek model in Settings → Models. Any model can search with it.",
  "license": "Apache-2.0",
  "author": {
    "name": "Tomrade"
  },
  "repository": "https://github.com/haoyuant/tomrade-plugins",
  "engines": {
    "sdk": "^0.2.9"
  },
  "main": "dist/index.js",
  "icon": "icon.svg",
  "permissions": {
    "network": [
      "api.deepseek.com"
    ],
    "fs": "none",
    "exec": false
  },
  "inject": [
    "settings",
    "webSearch"
  ],
  "optional": [],
  "contributes": {
    "webSearchProviders": [
      "deepseek_search"
    ]
  }
}
