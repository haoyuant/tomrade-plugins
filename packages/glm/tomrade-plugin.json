{
  "id": "tomrade/glm",
  "version": "0.1.0",
  "title": "Zhipu GLM",
  "description": "Zhipu's GLM models, on bigmodel.cn in mainland China or Z.ai internationally: paste an API key in Settings → Assistant and the assistant runs on GLM, searching the web with GLM's own search.",
  "license": "Apache-2.0",
  "author": {
    "name": "Tomrade"
  },
  "repository": "https://github.com/haoyuant/tomrade-plugins",
  "engines": {
    "sdk": "^0.2.16"
  },
  "main": "dist/index.js",
  "icon": "icon.svg",
  "permissions": {
    "network": [
      "open.bigmodel.cn",
      "api.z.ai"
    ],
    "fs": "none",
    "exec": false
  },
  "inject": [
    "models"
  ],
  "optional": [],
  "contributes": {
    "modelProviders": [
      "glm"
    ]
  }
}
